# Neon (or any PostgreSQL) connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Groq key for the AI reception desk — chat, speech to text and spoken replies.
# Server side only.
GROQ_API_KEY="gsk_..."

# Optional. Which Orpheus voice speaks the English replies. The model is gated
# behind a terms acceptance on the Groq console; until that is done the site
# falls back to the browser's own voice on its own.
# ORPHEUS_VOICE="tara"

# Password for /admin. Change this before going live; without it the portal
# falls back to the default password "valentino".
ADMIN_PASSWORD="change-me"
