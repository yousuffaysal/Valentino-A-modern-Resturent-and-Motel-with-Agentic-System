# Neon (or any PostgreSQL) connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Groq key for the AI reception desk (/api/chat). Server side only.
GROQ_API_KEY="gsk_..."

# Password for /admin. Change this before going live; without it the portal
# falls back to the default password "valentino".
ADMIN_PASSWORD="change-me"
